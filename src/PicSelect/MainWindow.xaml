<Window x:Class="PicSelect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PicSelect.Controls"
        Title="PicSelect"
        Height="880" Width="1320"
        MinHeight="520" MinWidth="840"
        Background="#1B1B1B"
        Foreground="#E6E6E6"
        FontFamily="Microsoft YaHei UI, Yu Gothic UI, Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 语言下拉框：自绘模板，避免系统默认的浅色样式在深色工具栏里突兀 -->
        <Style x:Key="LangItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4A5C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LangItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,1"
                                  Data="M0,0 L4.5,4.5 L9,0" Stroke="#9A9A9A" StrokeThickness="1.6"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="#2C2C2C" BorderBrush="#3C3C3C" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#343434" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#232323" BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnOpen" Style="{StaticResource ToolButton}" Click="OnOpenFolder" Content="Open folder" />
                    <Button x:Name="BtnJump" Style="{StaticResource ToolButton}" Click="OnJump" Content="Go to" Margin="8,0,0,0" />
                    <Button x:Name="BtnRestart" Style="{StaticResource ToolButton}" Click="OnRestart" Content="Restart" Margin="8,0,0,0" />
                    <Button x:Name="BtnHelp" Style="{StaticResource ToolButton}" Click="OnShowHelp" Content="Shortcuts" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ComboBox x:Name="LangCombo" Style="{StaticResource LangCombo}" Width="108"
                              Margin="0,0,14,0" SelectionChanged="OnLangChanged" />
                    <Button x:Name="BtnExport" Style="{StaticResource ToolButton}" Click="OnExportKeep" Content="Export kept list" />
                    <Button x:Name="BtnDelete" Style="{StaticResource ToolButton}" Click="OnDeleteUnmarked"
                            Content="Delete unmarked" Margin="8,0,0,0" Background="#3A1E1C" BorderBrush="#6B302C" Foreground="#E8A9A3" />
                </StackPanel>
                <TextBlock />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#1F1F1F" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFile" Grid.Column="0" FontSize="14" Foreground="#E6E6E6"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtMeta" Grid.Column="1" FontSize="12" Foreground="#7A7A7A"
                           Margin="18,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtPos" Grid.Column="2" FontSize="13" FontFamily="Consolas"
                           Foreground="#9A9A9A" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="164" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B0B0B">
                <Grid>
                    <controls:ImageViewer x:Name="Viewer" />

                    <Border x:Name="HintPanel" Background="#0B0B0B" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHint" Text="Drop a folder here, or click “Open folder”"
                                       FontSize="15" Foreground="#5A5A5A" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtHintSub" Text=""
                                       FontSize="12" Foreground="#454545" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="BusyBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16" Padding="10,5" CornerRadius="6"
                            Background="#B3000000" Visibility="Collapsed">
                        <TextBlock x:Name="TxtBusy" Text="Loading…" FontSize="12" Foreground="#CFCFCF" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#232323" BorderBrush="#303030" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="12,12,12,12">
                    <Button Style="{StaticResource ActionButton}" Click="OnKeepNext"
                            Background="#28401B" BorderBrush="#4E7A32">
                        <StackPanel>
                            <TextBlock x:Name="TxtKeepTitle" Text="Keep" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="#B8E08C" />
                            <TextBlock x:Name="TxtKeepHint" Text="Space / K" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#7FA75C" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Click="OnSkip"
                            Background="#3A1E1C" BorderBrush="#6B302C">
                        <StackPanel>
                            <TextBlock x:Name="TxtSkipTitle" Text="Next" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="#E8A9A3" />
                            <TextBlock x:Name="TxtSkipHint" Text="D / →" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#B87C76" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Click="OnPrev">
                        <StackPanel>
                            <TextBlock x:Name="TxtPrevTitle" Text="Previous" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="#D0D0D0" />
                            <TextBlock x:Name="TxtPrevHint" Text="A / ←" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#8A8A8A" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMark" Style="{StaticResource ActionButton}" Click="OnToggleMark"
                            Background="#16304D" BorderBrush="#2F5C8C">
                        <StackPanel>
                            <TextBlock x:Name="TxtMarkTitle" Text="Mark" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="#9CC6F0" />
                            <TextBlock x:Name="TxtMarkHint" Text="S" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#6E9BC7" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="#333333" Margin="4,6,4,10" />

                    <Button Style="{StaticResource ActionButton}" Height="46" Click="OnPrevMarked"
                            Background="#242A31" BorderBrush="#3A4450">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="◀" FontSize="12" Foreground="#E8C55A"
                                           VerticalAlignment="Center" Margin="0,1,6,0" />
                                <TextBlock x:Name="TxtPrevMarkTitle" Text="Prev marked" FontSize="13"
                                           Foreground="#C6C6C6" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="TxtPrevMarkHint" Text="[ / Ctrl+←" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#7A7A7A" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Height="46" Click="OnNextMarked"
                            Background="#242A31" BorderBrush="#3A4450">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtNextMarkTitle" Text="Next marked" FontSize="13"
                                           Foreground="#C6C6C6" VerticalAlignment="Center" />
                                <TextBlock Text="▶" FontSize="12" Foreground="#E8C55A"
                                           VerticalAlignment="Center" Margin="6,1,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="TxtNextMarkHint" Text="] / Ctrl+→" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#7A7A7A" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="#333333" Margin="4,6,4,10" />

                    <Button Style="{StaticResource ActionButton}" Height="48" Click="OnUndo">
                        <TextBlock x:Name="TxtUndo" Text="Undo  Ctrl+Z" FontSize="12" Foreground="#9A9A9A" />
                    </Button>

                    <Border x:Name="MarkBadge" Margin="0,2,0,0" Padding="10,9" CornerRadius="6"
                            Background="#3D3210" BorderBrush="#8A6D1F" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtBadge" Text="✓ Kept" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#E8C55A" />
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#1F1F1F" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtProgress" Grid.Column="0" FontSize="12" Foreground="#8A8A8A"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                    <Border Background="#333333" CornerRadius="2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ProgDone" Width="0*" />
                            <ColumnDefinition x:Name="ProgRest" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#5FA83F" CornerRadius="2" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="TxtStatus" Grid.Column="2" FontSize="12" Foreground="#7A7A7A"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="TxtCache" Grid.Column="3" FontSize="11" FontFamily="Consolas"
                           Foreground="#5F5F5F" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
